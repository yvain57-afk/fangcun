{
  "schemaVersion": 1,
  "status": "animation_requirements_not_finished_assets",
  "policyVersion": "companion-v2.0",
  "referenceCommit": "99ebe69f30a2a502225e913a9dfd35f54101dabd",
  "removeUserRoutes": [
    "lookAtCompanion",
    "replayCompanion",
    "companionViewingSheet"
  ],
  "interaction": "decorative_no_independent_button_or_gesture",
  "scenes": [
    {
      "scene": "calm",
      "asset": "Companion-duo-calm",
      "durationSeconds": 1.8,
      "event": "screenEntered",
      "choreography": [
        "dog_head_small_tilt",
        "ear_follow_through_if_mask_supported",
        "tail_tip_two_small_wags",
        "settle"
      ],
      "idleIntervalSeconds": [
        60,
        90
      ],
      "maxNoticeableIdlePerMinute": 1
    },
    {
      "scene": "rest",
      "asset": "Companion-dog-rest",
      "durationSeconds": 1.6,
      "event": "guidanceChanged",
      "choreography": [
        "settle_head_down",
        "small_local_torso_motion",
        "settle"
      ],
      "idle": "mostly_static"
    },
    {
      "scene": "curious",
      "asset": "Companion-cat-curious",
      "durationSeconds": 1.6,
      "event": "screenEntered",
      "choreography": [
        "small_head_tilt",
        "ear_tip_motion_if_supported",
        "return_to_rest"
      ],
      "infiniteLoadingLoop": false
    },
    {
      "scene": "drink",
      "asset": "Companion-dog-drink",
      "durationSeconds": 1.1,
      "event": "drinkCommitted",
      "openDurationSeconds": 0.8,
      "water": [
        "masked_waterline_change",
        "small_nod",
        "short_tail_motion",
        "settle"
      ],
      "coffeeAlcoholDurationSeconds": 0.6,
      "coffeeAlcohol": [
        "neutral_small_nod",
        "settle"
      ],
      "undoDurationSeconds": 0.25,
      "undo": [
        "reverse_waterline_or_local_confirmation_state"
      ],
      "requiresCommitted": true,
      "celebrateAlcohol": false,
      "animalConsumesCoffeeOrAlcohol": false
    },
    {
      "scene": "breathe",
      "asset": "Companion-breathing",
      "event": "practicePhaseChanged",
      "clock": "existing_authoritative_practice_clock",
      "secondBreathingOscillator": false,
      "pause": "freeze_pose",
      "offscreen": "no_decorative_clock",
      "timingChangedByMotionPreference": false
    },
    {
      "scene": "complete",
      "asset": "Companion-duo-complete",
      "event": "practiceCompleted",
      "durationSeconds": 1.3,
      "requiresCommitted": true,
      "choreography": [
        "small_paw_touch_in_existing_pose",
        "settle"
      ],
      "earlyEndAsset": "Companion-dog-rest",
      "earlyEndDurationSeconds": 0.8,
      "earlyEnd": [
        "small_reassuring_nod",
        "settle"
      ],
      "showFailureForEarlyEnd": false
    }
  ],
  "artworkConstraints": {
    "preserveOriginalFeatures": true,
    "nonDestructiveMasksOnly": true,
    "noFullImageSquashStretch": true,
    "noUnsupportedBlinkOrRedrawnFace": true,
    "maximumGroundAnchorDriftPT": 1,
    "initialHeadRotationDegrees": [
      2,
      4
    ],
    "initialLocalDisplacementPT": [
      1,
      3
    ],
    "darkModeWhiteRectangle": false
  },
  "scheduler": {
    "maxSimultaneousNoticeableActions": 1,
    "priority": [
      "practicePhase",
      "committedFeedback",
      "entry",
      "idle"
    ],
    "dedupKey": [
      "eventID",
      "origin",
      "entityID",
      "revision"
    ],
    "discardBackgroundBacklog": true,
    "remoteHistoryDoesNotAnimateSuccess": true,
    "maxActiveDecorativeFPS": 30,
    "staticConstantTimeline": false
  },
  "accessibility": {
    "modes": [
      "standard",
      "gentle",
      "static"
    ],
    "systemReduceMotionWins": true,
    "lowPowerStopsDecorativeLoop": true,
    "decorativeVoiceOverHidden": true,
    "confirmationInformationAlsoInText": true
  },
  "requiredEvidence": [
    "synthetic_home_recording",
    "synthetic_water_recording",
    "synthetic_breathing_pause_resume_recording",
    "all_six_scene_recordings",
    "static_artwork_comparison",
    "dark_large_type",
    "human_cuteness_review"
  ]
}
