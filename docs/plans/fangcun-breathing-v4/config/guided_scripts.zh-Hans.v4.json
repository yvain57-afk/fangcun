        {
          "startSeconds": 0,
          "endSeconds": 25,
          "focus": "settle",
          "text": "找一个舒服、能坐稳的姿势。把手自然放好。",
          "repeat": false
        },
        {
          "startSeconds": 25,
          "endSeconds": 55,
          "focus": "support",
          "text": "感觉身体与椅子或垫子接触，先在这里停一下。",
          "repeat": false
        },
        {
          "startSeconds": 55,
          "endSeconds": 100,
          "focus": "breath",
          "text": "留意一口自然的呼吸。让呼吸按自己的节奏发生。",
          "repeat": false
        },
        {
          "startSeconds": 100,
          "endSeconds": 145,
          "focus": "return",
          "text": "发现走神，就把注意力轻轻带回这一口呼吸。",
          "repeat": false
        },
        {
          "startSeconds": 145,
          "endSeconds": 200,
          "focus": "allow",
          "text": "念头可以来，也可以走。暂时不用跟着它继续想。",
          "repeat": false
        },
        {
          "startSeconds": 200,
          "endSeconds": 260,
          "focus": "return",
          "text": "再感觉一次身体被托住。把注意力带回此刻。",
          "repeat": false
        },
        {
          "startSeconds": 260,
          "endSeconds": 285,
          "focus": "breath",
          "text": "留意接下来的几口自然呼吸。",
          "repeat": false
        },
        {
          "startSeconds": 285,
          "endSeconds": 300,
          "focus": "finish",
          "text": "感受身边的声音，轻轻动动手。准备好后，带着这份注意继续今天。",
          "repeat": false
        }
      ]
    },
