  "tracks": [
    {
      "practiceID": "nsdr",
      "durationSeconds": 600,
      "segments": [
        {
          "startSeconds": 0,
          "endSeconds": 30,
          "focus": "settle",
          "text": "找个可以躺稳的位置，把身体交给床面或垫子。接下来，跟着声音休息。",
          "repeat": false
        },
        {
          "startSeconds": 30,
          "endSeconds": 60,
          "focus": "settle",
          "text": "轻轻闭眼，或把视线放低。你不用一直看屏幕。",
          "repeat": false
        },
        {
          "startSeconds": 60,
          "endSeconds": 90,
          "focus": "face",
          "text": "松开眼周，让下颌和舌头都轻松一点。",
          "repeat": false
        },
        {
          "startSeconds": 90,
          "endSeconds": 130,
          "focus": "shoulders",
          "text": "让两侧肩膀落下来。背部的重量，交给下面的支撑。",
          "repeat": false
        },
        {
          "startSeconds": 130,
          "endSeconds": 170,
          "focus": "arms",
          "text": "注意上臂、前臂，再到双手。让手指自然弯着。",
          "repeat": false
        },
        {
          "startSeconds": 170,
          "endSeconds": 210,
          "focus": "hands",
          "text": "感受手掌的重量。现在不用抓住任何东西。",
          "repeat": false
        },
        {
          "startSeconds": 210,
          "endSeconds": 250,
          "focus": "breath",
          "text": "留意一口自然呼吸。让空气自己进来，再出去。",
          "repeat": false
        },
        {
          "startSeconds": 250,
          "endSeconds": 290,
          "focus": "belly",
          "text": "腹部不用收紧。让腰腹得到支撑，随着自然呼吸轻轻移动。",
          "repeat": false
        },
        {
          "startSeconds": 290,
          "endSeconds": 330,
          "focus": "hips",
          "text": "感受骨盆与垫子接触的位置，把重量放下。",
          "repeat": false
        },
        {
          "startSeconds": 330,
          "endSeconds": 370,
          "focus": "legs",
          "text": "注意大腿和小腿。让双腿休息，不用主动绷直。",
          "repeat": false
        },
        {
          "startSeconds": 370,
          "endSeconds": 415,
          "focus": "feet",
          "text": "脚踝放松，脚趾松开。感受双脚也被托住。",
          "repeat": false
        },
        {
          "startSeconds": 415,
          "endSeconds": 460,
          "focus": "whole",
          "text": "从头到脚感受整个身体。让支撑面接住你的重量。",
          "repeat": false
        },
        {
          "startSeconds": 460,
          "endSeconds": 510,
          "focus": "breath",
          "text": "注意再一口自然的呼吸。不需要调整它。",
          "repeat": false
        },
        {
          "startSeconds": 510,
          "endSeconds": 570,
          "focus": "quiet",
          "text": "接下来安静待一会儿。听到声音，再慢慢回来。",
          "repeat": false
        },
        {
          "startSeconds": 570,
          "endSeconds": 600,
          "focus": "return",
          "text": "轻轻动动手指和脚趾。感受身边的空间，准备好时慢慢睁开眼睛。",
          "repeat": false
        }
      ]
    },
