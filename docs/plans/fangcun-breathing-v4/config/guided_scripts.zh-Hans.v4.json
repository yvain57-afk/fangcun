      "segments": [
        {
          "startSeconds": 0,
          "endSeconds": 25,
          "focus": "settle",
          "text": "坐稳或舒适地躺好，一只手轻放腹部或下肋。",
          "repeat": false
        },
        {
          "startSeconds": 25,
          "endSeconds": 50,
          "focus": "lowerRibs",
          "text": "吸气时，感觉下肋和腹部轻轻展开。肩膀不需要抬起来。",
          "repeat": false
        },
        {
          "startSeconds": 50,
          "endSeconds": 85,
          "focus": "release",
          "text": "呼气时，让腹部自然回落，不要向里用力挤。",
          "repeat": false
        },
        {
          "startSeconds": 85,
          "endSeconds": 120,
          "focus": "natural",
          "text": "现在按自己的节奏呼吸，手只用来感受。",
          "repeat": false
        },
        {
          "startSeconds": 120,
          "endSeconds": 155,
          "focus": "relax",
          "text": "松开下颌和肩膀，继续轻柔呼吸。",
          "repeat": false
        },
        {
          "startSeconds": 155,
          "endSeconds": 175,
          "focus": "independent",
          "text": "把手放回舒服的位置，继续几口自然呼吸。",
          "repeat": false
        },
        {
          "startSeconds": 175,
          "endSeconds": 180,
          "focus": "finish",
          "text": "记住这份不费力的动作，慢慢结束练习。",
          "repeat": false
        }
      ]
