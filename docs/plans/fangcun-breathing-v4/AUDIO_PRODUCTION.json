      "postEncodeGainDB": -0.5300000000000011
    },
    {
      "resource": "practice_v4_nsdr_600_11",
      "text": "从头到脚感受整个身体。让支撑面接住你的重量。",
      "windowSeconds": 45,
      "type": "segment",
      "startSeconds": 415,
      "endSeconds": 460,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 5.916009,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_nsdr_600_11.m4a",
      "sha256": "5f35d5057841418b72364311f2ff5d5e80f5ad23213f418a9daed51cdced2b4c",
      "postEncodeGainDB": -0.8099999999999987
    },
    {
      "resource": "practice_v4_nsdr_600_12",
      "text": "注意再一口自然的呼吸。不需要调整它。",
      "windowSeconds": 50,
      "type": "segment",
      "startSeconds": 460,
      "endSeconds": 510,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.5,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_nsdr_600_12.m4a",
      "sha256": "cc9f58afa6a9a000a197ef8c6342208b3f7ad6168917bf96ec63b88f6ef48625",
      "postEncodeGainDB": 0
    },
    {
      "resource": "practice_v4_nsdr_600_13",
      "text": "接下来安静待一会儿。听到声音，再慢慢回来。",
      "windowSeconds": 60,
      "type": "segment",
      "startSeconds": 510,
      "endSeconds": 570,
