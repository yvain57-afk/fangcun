      "sha256": "5f4d88d697be9ac2fa07b9a1e7ad1bc3b966567626f80d6bb3d78ace1de62941",
      "postEncodeGainDB": -0.3299999999999983
    },
    {
      "resource": "practice_v4_meditation_600_6",
      "text": "你注意到自己在想别的事，就已经有了回来的机会。再回到呼吸。",
