      "postEncodeGainDB": 0.7100000000000009
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_180_0",
      "text": "坐稳或舒适地躺好，一只手轻放腹部或下肋。",
      "windowSeconds": 25,
      "type": "segment",
      "startSeconds": 0,
      "endSeconds": 25,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.900998,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_180_0.m4a",
      "sha256": "0bbdfa80192298f3b2cf461e97065315c1902bb19567d9bd1a427b4f0e7e1c56",
      "postEncodeGainDB": 0.6499999999999986
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_180_1",
      "text": "吸气时，感觉下肋和腹部轻轻展开。肩膀不需要抬起来。",
      "windowSeconds": 25,
      "type": "segment",
      "startSeconds": 25,
      "endSeconds": 50,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 6.4,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_180_1.m4a",
      "sha256": "b3881a1a3dec9efaf696021f9e80ae9987af12465500ab1988f98c99805c8f38",
      "postEncodeGainDB": 0.21999999999999886
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_180_2",
      "text": "呼气时，让腹部自然回落，不要向里用力挤。",
      "windowSeconds": 35,
      "type": "segment",
      "startSeconds": 50,
      "endSeconds": 85,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.806009,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_180_2.m4a",
      "sha256": "9a3999f894b1597e3cc37c6a682ec19aa8be9bee9e6ef2d33652dffeccf75fb8",
      "postEncodeGainDB": -0.23000000000000043
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_180_3",
      "text": "现在按自己的节奏呼吸，手只用来感受。",
      "windowSeconds": 35,
      "type": "segment",
      "startSeconds": 85,
      "endSeconds": 120,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.320998,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_180_3.m4a",
      "sha256": "5dd02a5eb516e1c824c4b10f8625d33f3e31959d5647727a7078ba401d34cd50",
      "postEncodeGainDB": 0.3200000000000003
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_180_4",
      "text": "松开下颌和肩膀，继续轻柔呼吸。",
      "windowSeconds": 35,
      "type": "segment",
      "startSeconds": 120,
      "endSeconds": 155,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.0,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_180_4.m4a",
      "sha256": "a69b6c1520397b22e2fb92095e147d396b35b865c013b469812b33deacdfb71f",
      "postEncodeGainDB": 0
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_180_5",
      "text": "把手放回舒服的位置，继续几口自然呼吸。",
      "windowSeconds": 20,
      "type": "segment",
      "startSeconds": 155,
      "endSeconds": 175,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.610998,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_180_5.m4a",
      "sha256": "a1620563e8bc0b98bc366d138d0f1ed510ee39959ed88d201ea0413f9f2746dc",
      "postEncodeGainDB": 1.120000000000001
    },
