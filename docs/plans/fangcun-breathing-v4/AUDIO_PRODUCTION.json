      "postEncodeGainDB": -0.23000000000000043
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_300_3",
      "text": "现在按自己的节奏呼吸，手只用来感受。",
      "windowSeconds": 65,
      "type": "segment",
      "startSeconds": 120,
      "endSeconds": 185,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.320998,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_300_3.m4a",
