      "postEncodeGainDB": 0.5899999999999999
    },
    {
      "resource": "practice_v4_nsdr_600_9",
      "text": "注意大腿和小腿。让双腿休息，不用主动绷直。",
      "windowSeconds": 40,
      "type": "segment",
      "startSeconds": 330,
      "endSeconds": 370,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 5.7,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_nsdr_600_9.m4a",
      "sha256": "32f70e34ae54533e422ec2b3cc0d48361cdc04d331a6fc6858c122c13fcc0d0e",
      "postEncodeGainDB": 0
    },
    {
      "resource": "practice_v4_nsdr_600_10",
      "text": "脚踝放松，脚趾松开。感受双脚也被托住。",
      "windowSeconds": 45,
      "type": "segment",
      "startSeconds": 370,
      "endSeconds": 415,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 5.41,
      "tempoAdjustment": 1,
