      "type": "segment",
      "startSeconds": 400,
      "endSeconds": 500,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 6.907007,
      "tempoAdjustment": 1,
