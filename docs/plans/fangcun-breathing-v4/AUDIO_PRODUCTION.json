      "postEncodeGainDB": 0.21999999999999886
    },
    {
      "resource": "practice_v4_diaphragmaticBreathing_300_2",
      "text": "呼气时，让腹部自然回落，不要向里用力挤。",
      "windowSeconds": 60,
      "type": "segment",
      "startSeconds": 60,
      "endSeconds": 120,
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "-6%",
      "pitch": "-2Hz",
      "durationSeconds": 4.806009,
      "tempoAdjustment": 1,
      "file": "InnerBalance/InnerBalanceApp/PracticeVoice/practice_v4_diaphragmaticBreathing_300_2.m4a",
