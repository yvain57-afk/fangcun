        }
      }
    },
    "care.W04.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录到今天的参考量"
          }
        }
      }
    },
    "care.W04.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后按自己的需要来，不用赶进度。"
          }
        }
      }
    },
    "care.water.recordsOnly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有记录，不等于没有喝过。"
          }
