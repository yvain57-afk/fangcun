      }
    },
    "care.water.coffeeCounts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里统计的是已记录饮品，不是全天实际摄入量。"
          }
        }
      }
    },
    "care.C01.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这杯咖啡因，时间可以留意一下"
          }
        }
      }
    },
    "care.C01.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已进入你设置的咖啡收尾时段。之后想喝点什么，可以考虑无咖啡因的选择。"
          }
        }
      }
    },
    "care.C02.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已知咖啡因达到你的参考量"
          }
        }
      }
    },
    "care.C02.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天接下来可以先停一停含咖啡因饮品，留意自己的感受。"
          }
        }
      }
    },
    "care.C03.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因的量和时间，都值得留意"
          }
        }
      }
    },
    "care.C03.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已知摄入达到参考量，也进入了你的收尾时段。接下来可以选择无咖啡因饮品。"
          }
        }
      }
    },
    "care.caffeine.partial": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分含量未知；这条参考仅合计已知部分，不表示剩下的摄入是安全的。"
          }
        }
      }
    },
    "care.caffeine.reference": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成人一般参考不等于个人安全上限，也不能预测今晚一定失眠。"
          }
        }
      }
    },
    "care.A01.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临近休息，先停一停酒饮"
          }
        }
      }
    },
    "care.A01.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以给今晚留一些安静的空间，并安排安全的返程。"
          }
        }
      }
    },
    "care.A02.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先停止饮酒，照顾好自己"
          }
        }
      }
    },
    "care.A02.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请不要驾驶。尽量和可信任的人待在一起，需要时请人帮助。"
          }
        }
      }
    },
    "care.A03.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酒精量还不确定"
          }
        }
      }
    },
    "care.A03.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先留意自己的感受，避免继续饮酒，不要驾驶。不能据未知含量判断喝多或没事。"
          }
        }
      }
    },
    "care.A04.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一段休息前，有一笔酒饮记录"
          }
        }
      }
    },
    "care.A04.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天可以按感受放缓安排。这笔记录不能证明宿醉或解释所有不适。"
          }
        }
      }
    },
    "care.A05.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些症状需要立即求助"
          }
        }
      }
    },
    "care.A05.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出现难以唤醒、呼吸缓慢或不规则、抽搐、反复呕吐或明显意识混乱，请立即联系当地急救，不要独自待着。不要用睡一觉、运动或呼吸练习替代急救。"
          }
        }
      }
    },
    "care.emergency": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即请身边的人联系当地急救；不要驾车自行就医。"
          }
        }
      }
    },
    "care.alcohol.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水、咖啡和呼吸练习都不能抵消酒精，也不能据此判断何时能驾驶。"
          }
        }
      }
    },
    "care.fluidRestricted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你设置了液体限制，请遵循医生给你的饮水安排。"
          }
        }
      }
    },
    "care.notification.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方寸"
          }
        }
      }
    },
    "care.notification.generic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给自己留一点缓冲。"
          }
        }
      }
    },
    "care.notification.water": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忙了一阵，给水杯续一点？按自己的需要来。"
          }
        }
      }
    },
    "care.notification.caffeine": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快到你设定的咖啡收尾时间了。"
          }
        }
      }
    },
    "care.notification.alcohol": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到了你预约关照自己的时间。先休息，并安排安全返程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
