        }
      }
    },
    "care.W03.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忙了一阵，给水杯续一点？"
          }
        }
      }
    },
    "care.W03.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
