      "extractionState": "manual",
      "comment": "M1 current-evidence semantics; review via COPY_REVIEW.csv",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期有至少 45 分钟训练，处于旧判断的 18 小时保护窗口。心血管偏离可能受运动影响，仍在上方保留；保护窗口不代表各项指标正常。"
          }
        }
      }
    },
